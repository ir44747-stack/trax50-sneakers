# ------------------------------------------------------------------
# Trax.50 — Environment Variables (example)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ------------------------------------------------------------------

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App / Brand
NEXT_PUBLIC_SITE_NAME=Trax.50
NEXT_PUBLIC_SITE_DESCRIPTION=Luxury & streetwear sneaker drops — curated affiliate picks.

# Affiliate / Analytics (Phase 3+ placeholders)
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_AFFILIATE_BASE_URL=

# ------------------------------------------------------------------
# Sovrn Commerce (affiliate monetization)
# Required for production. Wrapped links use the Sovrn/VigLink gateway:
#   https://redirect.viglink.com?key=<key>&u=<encoded destination>
#
# VALUE: use your Sovrn **API key** (not the secret). It MUST be set as a
# Vercel environment variable (Production/Preview/Development) so build-time
# link generation uses your real publisher key.
# When unset locally, a clearly-marked DEMO key is used so the validation
# pipeline stays testable, and a build-time warning is emitted.
# ------------------------------------------------------------------
SOVRN_PUBLISHER_KEY=

# Sovrn API secret — ONLY needed if you call Sovrn's server-side API.
# Keep it out of code; store in Vercel encrypted secrets if used.
# SOVRN_API_SECRET=

# Instagram (source account)
# NEXT_PUBLIC_INSTAGRAM_HANDLE=trax.50
